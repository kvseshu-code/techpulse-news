{
  "version": 3,
  "features": {
    "localization": {
      "enabled": true,
      "supported": [
        "en",
        "hi",
        "te",
        "ta",
        "kn",
        "mr"
      ]
    },
    "themes": {
      "enabled": true,
      "supported": [
        "dark",
        "light",
        "glass"
      ]
    },
    "daily_brief": {
      "enabled": true,
      "max_stories": 15,
      "narrate_all": true
    },
    "ask_techpulse": {
      "enabled": true,
      "mode": "dataset_search"
    },
    "global_search": {
      "enabled": true
    },
    "saved_stories": {
      "enabled": true,
      "storage": "localStorage"
    },
    "browser_speech": {
      "enabled": true
    },
    "reduced_motion": {
      "enabled": true
    },
    "tp_score": {
      "enabled": true,
      "range": [
        0,
        100
      ],
      "weights": {
        "importance": 30,
        "confidence": 25,
        "freshness": 20,
        "momentum": 15,
        "source_quality": 10
      }
    },
    "source_health": {
      "enabled": true,
      "mode": "dataset-derived"
    },
    "developing_story_tracker": {
      "enabled": true
    },
    "static_scale": {
      "enabled": true,
      "cache_first": true
    },
    "edge_security_headers": {
      "enabled": true,
      "required_for_production": true
    }
  }
}
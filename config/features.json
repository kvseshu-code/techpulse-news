{
  "version": 2,
  "features": {
    "localization": {
      "enabled": true,
      "supported": [
        "en",
        "hi",
        "te",
        "ta",
        "kn",
        "mr"
      ]
    },
    "themes": {
      "enabled": true,
      "supported": [
        "dark",
        "light",
        "glass"
      ]
    },
    "daily_brief": {
      "enabled": true,
      "max_stories": 15,
      "narrate_all": true,
      "controls": [
        "play",
        "pause",
        "previous",
        "next",
        "stop"
      ]
    },
    "ask_techpulse": {
      "enabled": true,
      "mode": "dataset_search"
    },
    "global_search": {
      "enabled": true
    },
    "saved_stories": {
      "enabled": true,
      "storage": "localStorage"
    },
    "browser_speech": {
      "enabled": true
    },
    "reduced_motion": {
      "enabled": true
    }
  }
}